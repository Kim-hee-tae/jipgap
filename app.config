# ── 앱 배포 설정 (kairu-kit/deploy/app.config 기준) ──
APP_NAME="jipgap"              # 영문 소문자 — systemd 서비스 이름, 도메인 앞부분 (jipgap.<IP>.sslip.io)
APP_TITLE="집값 점수판"
PORT=3020                      # 따릉이 3000, 지하철 3001, 청룡 3002, 홈페이지 3010 과 안 겹치게
HEALTH_PATH="/api/status"
ENTRY="server.js"
MEMORY_MAX="600M"              # 하루 한 번 실거래 전국 집계를 자식 프로세스로 돌려서 여유 있게
USE_PUSH=0

# 배포할 때 물어볼 .env 값 (이미 있으면 안 물어봄). 비워 두면 데모 데이터로 돈다.
ASK_ENV=(
  "MOLIT_KEY|공공데이터포털 인증키 (아파트 매매·전월세 실거래가 API 활용신청한 키, 엔터=데모)"
  "ECOS_KEY|한국은행 ECOS 인증키 (금리 지표, 엔터=건너뜀)"
  "KOSIS_UNSOLD_URL|KOSIS 미분양주택현황 OpenAPI URL 전체 (엔터=건너뜀)"
)
